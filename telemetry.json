name: MLT001 Polyglot Build & Telemetry

on:
  push:
    branches: ["main"]
  workflow_dispatch:

permissions:
  contents: write

jobs:
  execute-polyglot-engines:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout MLT001 Repository
        uses: actions/checkout@v4

      - name: Setup Python 3.12
        uses: actions/setup-python@v5
        with:
          python-version: "3.12"

      - name: Setup .NET 8 SDK
        uses: actions/setup-dotnet@v4
        with:
          dotnet-version: "8.0.x"

      - name: Run Python Portfolio Analytics
        run: python3 analytics.py

      - name: Run C# QuantCore Engine
        run: dotnet run --project MLT001.csproj > quant-output.json

      - name: Commit Generated Telemetry
        run: |
          git config user.name "github-actions[bot]"
          git config user.email "github-actions[bot]@users.noreply.github.com"
          git add telemetry.json quant-output.json
          git diff --quiet && git diff --staged --quiet || git commit -m "chore(ci): update Python & C# telemetry"
          git push
